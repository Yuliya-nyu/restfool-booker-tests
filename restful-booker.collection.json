		{
			"name": "Delete Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200, 201 or 204\", () => {",
							"    pm.expect([200, 201, 204]).to.include(pm.response.code);",
							"});",
							"pm.test(\"Response has Content-Type header\", () => {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"});",
							"pm.test(\"Response body is empty or confirmation text\", () => {",
							"    const body = pm.response.text();",
							"    pm.expect(body).to.be.a(\"string\");",
							"    pm.expect(body.length).to.be.at.least(0);",
							"});"
